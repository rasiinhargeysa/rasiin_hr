 "font_size": 14,
 "html": "<style>\r\n    .jp-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 0; }\r\n    .jp-table td, .jp-table th {\r\n        border: 1px solid #000; padding: 4px 6px; vertical-align: top;\r\n    }\r\n    .jp-section-title {\r\n        background: #fff; color: #d2691e; font-weight: bold; font-size: 13px;\r\n        text-align: center; border: 1px solid #000; padding: 4px;\r\n    }\r\n    .jp-label { font-weight: bold; width: 18%; }\r\n    .jp-label-2 { font-weight: bold; width: 15%; }\r\n    .jp-block-title { font-weight: bold; padding: 4px 6px; border: 1px solid #000; }\r\n    .jp-checkbox { display: inline-block; width: 10px; height: 10px; border: 1px solid #000; margin-right: 4px; }\r\n    .jp-list td { padding: 4px 6px; }\r\n    .jp-no-border-bottom { border-bottom: none; }\r\n    .jp-no-border-top { border-top: none; }\r\n    ol.jp-ol { margin: 0; padding-left: 18px; }\r\n    ol.jp-ol li { padding: 2px 0; }\r\n</style>\r\n\r\n<div style=\"margin-bottom: 10px;\">\r\n    {{ letter_head }}\r\n</div>\r\n\r\n<h2 style=\"text-align:center; margin-bottom: 10px;\">Job Profile Template</h2>\r\n\r\n<table class=\"jp-table\">\r\n    <tr>\r\n        <td class=\"jp-label\">Job Title:</td>\r\n        <td>{{ doc.job_title or \"\" }}</td>\r\n        <td class=\"jp-label\">Responsible to:</td>\r\n        <td>{{ doc.responsible_to or \"\" }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"jp-label\">Job Grade:</td>\r\n        <td>{{ doc.job_grade or \"\" }}</td>\r\n        <td class=\"jp-label\">Accountable to:</td>\r\n        <td>{{ doc.accountable_to or \"\" }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"jp-label\">Department:</td>\r\n        <td>{{ doc.department or \"\" }}</td>\r\n        <td class=\"jp-label\">Employment Type:</td>\r\n        <td>\r\n            <span class=\"jp-checkbox\">{{ \"&#10003;\" | safe if doc.employment_type == \"Full Time\" else \"\" }}</span> Full-time\r\n            &nbsp;&nbsp;\r\n            <span class=\"jp-checkbox\">{{ \"&#10003;\" | safe if doc.employment_type == \"Part Time\" else \"\" }}</span> Part-time\r\n        </td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"jp-label\">Monthly Wage:</td>\r\n        <td>{{ doc.monthly_wage or \"\" }}</td>\r\n        <td class=\"jp-label\">Working Hours /Week:</td>\r\n        <td>{{ doc.working_hours_week or \"\" }}</td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"jp-table\" style=\"margin-top: -1px;\">\r\n    <tr><td colspan=\"2\" class=\"jp-section-title\">Job Description</td></tr>\r\n    <tr>\r\n        <td class=\"jp-label-2\">Purpose of the Role:</td>\r\n        <td>{{ doc.purpose_of_the_role or \"\" }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"jp-label-2\">Working Conditions:</td>\r\n        <td>{{ doc.working_conditions or \"\" }}</td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"jp-table\" style=\"margin-top: -1px;\">\r\n    <tr><td class=\"jp-block-title\">Key Responsibilities:</td></tr>\r\n    <tr>\r\n        <td>\r\n            <ol class=\"jp-ol\">\r\n                {% for row in doc.key_responsibilities %}\r\n                <li>{{ row.key_responsibilities or \"\" }}</li>\r\n                {% endfor %}\r\n            </ol>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"jp-table\" style=\"margin-top: -1px;\">\r\n    <tr><td class=\"jp-block-title\">KPIs:</td></tr>\r\n    <tr>\r\n        <td>\r\n            <ol class=\"jp-ol\">\r\n                {% for row in doc.kpis %}\r\n                <li>{{ row.kpis  or \"\" }}</li>\r\n                {% endfor %}\r\n            </ol>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"jp-table\" style=\"margin-top: -1px;\">\r\n    <tr><td colspan=\"3\" class=\"jp-section-title\">Person Specification</td></tr>\r\n    <tr>\r\n        <td style=\"width: 40%;\"></td>\r\n        <td style=\"width: 30%; font-weight: bold;\">Essential</td>\r\n        <td style=\"width: 30%; font-weight: bold;\">Desirable</td>\r\n    </tr>\r\n    {% for row in doc.person_specification %}\r\n    <tr>\r\n        <td style=\"font-weight: bold;\">{{ row.education  or \"\" }}</td>\r\n        <td>{{ row.essential or \"\" }}</td>\r\n        <td>{{ row.desirable or \"\" }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n</table>\r\n\r\n<table class=\"jp-table\" style=\"margin-top: -1px;\">\r\n    <tr><td colspan=\"2\" class=\"jp-section-title\">Skills &amp; Competencies</td></tr>\r\n    <tr>\r\n        <td class=\"jp-label-2\">Technical:</td>\r\n        <td>{{ doc.technical or \"\" }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"jp-label-2\">Soft Skills:</td>\r\n        <td>{{ doc.soft_skills or \"\" }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"jp-label-2\">Leadership:</td>\r\n        <td>{{ doc.leadership or \"\" }}</td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"jp-table\" style=\"margin-top: -1px;\">\r\n    <tr><td colspan=\"4\" class=\"jp-section-title\">Approvals</td></tr>\r\n    <tr>\r\n        <td style=\"font-weight: bold;\">Role</td>\r\n        <td style=\"font-weight: bold;\">Name</td>\r\n        <td style=\"font-weight: bold;\">Signature</td>\r\n        <td style=\"font-weight: bold;\">Date</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"font-weight: bold;\">Hiring Manager</td>\r\n        <td>&nbsp;</td>\r\n        <td>&nbsp;</td>\r\n        <td>&nbsp;</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"font-weight: bold;\">HR Manager</td>\r\n        <td>&nbsp;</td>\r\n        <td>&nbsp;</td>\r\n        <td>&nbsp;</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"font-weight: bold;\">Hospital Director</td>\r\n        <td>&nbsp;</td>\r\n        <td>&nbsp;</td>\r\n        <td>&nbsp;</td>\r\n    </tr>\r\n</table>",
