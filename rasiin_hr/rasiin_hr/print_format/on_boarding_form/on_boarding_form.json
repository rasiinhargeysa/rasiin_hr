 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"onboarding-print\">\r\n  <style>\r\n    .onboarding-print { font-family: Arial, sans-serif; color: #000; font-size: 10.5pt; }\r\n    .onboarding-print .header-table { width: 100%; border-collapse: collapse; margin-bottom: 6px; }\r\n    .onboarding-print .header-table td { vertical-align: middle; border: none; padding: 2px 6px; }\r\n    .onboarding-print .logo-img { max-height: 50px; }\r\n    .onboarding-print .company-name { font-weight: bold; color: #d97b1f; font-size: 9pt; line-height: 1.2; }\r\n    .onboarding-print .company-name .ar { display: block; }\r\n    .onboarding-print .tagline { color: #1f3d7a; font-weight: bold; text-align: right; font-size: 10pt; line-height: 1.3; }\r\n    .onboarding-print .divider { border-top: 2px solid #d97b1f; margin: 4px 0 8px 0; }\r\n    .onboarding-print h1.title { text-align: center; font-size: 15pt; font-weight: bold; letter-spacing: 1px; margin: 6px 0 12px 0; }\r\n\r\n    .onboarding-print .details-box { border: 2px solid #000; margin-bottom: 14px; }\r\n    .onboarding-print .details-header { border-bottom: 2px solid #000; font-weight: bold; padding: 4px 8px; }\r\n    .onboarding-print .details-grid { display: flex; flex-wrap: wrap; }\r\n    .onboarding-print .details-cell { width: 50%; box-sizing: border-box; padding: 6px 8px; border-bottom: 1px solid #000; }\r\n    .onboarding-print .details-cell:nth-child(odd) { border-right: 1px solid #000; }\r\n    .onboarding-print .details-cell:nth-last-child(-n+2) { border-bottom: none; }\r\n    .onboarding-print .details-cell .lbl { font-weight: bold; }\r\n    .onboarding-print .details-cell .val { border-bottom: 1px solid #000; display: inline-block; min-width: 60%; padding-bottom: 1px; margin-left: 4px; }\r\n\r\n    .onboarding-print table.activity-table { width: 100%; border-collapse: collapse; margin-bottom: 14px; table-layout: fixed; }\r\n    .onboarding-print table.activity-table th, .onboarding-print table.activity-table td {\r\n      border: 1px solid #000; padding: 5px 7px; font-size: 9.5pt; vertical-align: top; word-wrap: break-word;\r\n    }\r\n    .onboarding-print table.activity-table th { font-weight: bold; text-align: left; }\r\n    .onboarding-print table.activity-table col.col-person { width: 15%; }\r\n    .onboarding-print table.activity-table col.col-date { width: 10%; }\r\n    .onboarding-print table.activity-table col.col-activities { width: 55%; }\r\n    .onboarding-print table.activity-table col.col-sign { width: 20%; }\r\n    .onboarding-print table.activity-table td.person-cell { font-weight: bold; text-align: center; vertical-align: middle; }\r\n\r\n    .onboarding-print .footer-note { margin-top: 10px; font-size: 10pt; }\r\n  </style>\r\n\r\n  <!-- Header: logo + tagline -->\r\n{{ letter_head }}\r\n  <div class=\"divider\"></div>\r\n\r\n  <h1 class=\"title\">ON BOARDING FORM</h1>\r\n\r\n  <!-- Employee Details -->\r\n  <div class=\"details-box\">\r\n    <div class=\"details-header\">EMPLOYEE DETAILS</div>\r\n    <div class=\"details-grid\">\r\n      <div class=\"details-cell\"><span class=\"lbl\">EMPLOYEE NAME:</span><span class=\"val\">{{ doc.employee_name or \"\" }}</span></div>\r\n      <div class=\"details-cell\"><span class=\"lbl\">JOINING DATE:</span><span class=\"val\">{{ frappe.utils.formatdate(doc.joining_date) if doc.joining_date else \"\" }}</span></div>\r\n      <div class=\"details-cell\"><span class=\"lbl\">EMPLOYEE CODE:</span><span class=\"val\">{{ doc.employee or \"\" }}</span></div>\r\n      <div class=\"details-cell\"><span class=\"lbl\">DEPARTMENT:</span><span class=\"val\">{{ doc.department or \"\" }}</span></div>\r\n      <div class=\"details-cell\"><span class=\"lbl\">JOB TITLE:</span><span class=\"val\">{{ doc.job_title or \"\" }}</span></div>\r\n      <div class=\"details-cell\"></div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- On-Boarding Activities Table -->\r\n  <table class=\"activity-table\">\r\n    <colgroup>\r\n      <col class=\"col-person\">\r\n      <col class=\"col-date\">\r\n      <col class=\"col-activities\">\r\n      <col class=\"col-sign\">\r\n    </colgroup>\r\n    <thead>\r\n      <tr>\r\n        <th>ON-BOARDING<br>ASSIGNED PERSON</th>\r\n        <th>DATE</th>\r\n        <th>KEY ACTIVITIES</th>\r\n        <th>INDUCTEE SIGNATURE</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      {% set ns = namespace(processed=[]) %}\r\n      {% for row in doc.on_boarding_form_item %}\r\n        {% if row.on_boarding_assigned_person not in ns.processed %}\r\n          {% set count = doc.on_boarding_form_item | selectattr(\"on_boarding_assigned_person\", \"equalto\", row.on_boarding_assigned_person) | list | length %}\r\n          <tr>\r\n            <td class=\"person-cell\" rowspan=\"{{ count }}\">{{ row.on_boarding_assigned_person or \"\" }}</td>\r\n            <td>{{ frappe.utils.formatdate(row.date) if row.date else \"\" }}</td>\r\n            <td>{{ row.key_activities or \"\" }}</td>\r\n            <td></td>\r\n          </tr>\r\n          {% set ns.processed = ns.processed + [row.on_boarding_assigned_person] %}\r\n        {% else %}\r\n          <tr>\r\n            <td>{{ frappe.utils.formatdate(row.date) if row.date else \"\" }}</td>\r\n            <td>{{ row.key_activities or \"\" }}</td>\r\n            <td></td>\r\n          </tr>\r\n        {% endif %}\r\n      {% endfor %}\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- Footer -->\r\n  <div class=\"footer-note\">\r\n    <strong>Note:</strong> Completed form should be returned to the Human Resource Manager.\r\n  </div>\r\n</div>",
