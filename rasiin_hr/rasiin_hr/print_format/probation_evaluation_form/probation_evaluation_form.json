 "font_size": 14,
 "html": "<div class=\"probation-eval-print\">\r\n  <style>\r\n    .probation-eval-print { font-family: Arial, sans-serif; color: #000; font-size: 11pt; }\r\n    .probation-eval-print .header-table { width: 100%; border-collapse: collapse; margin-bottom: 6px; }\r\n    .probation-eval-print .header-table td { vertical-align: middle; border: none; padding: 2px 6px; }\r\n    .probation-eval-print .logo-img { max-height: 55px; }\r\n    .probation-eval-print .company-name { font-weight: bold; color: #d97b1f; font-size: 10pt; line-height: 1.2; }\r\n    .probation-eval-print .company-name .ar { display: block; }\r\n    .probation-eval-print .tagline { color: #1f3d7a; font-weight: bold; text-align: right; font-size: 11pt; line-height: 1.3; }\r\n    .probation-eval-print .divider { border-top: 2px solid #d97b1f; margin: 4px 0 10px 0; }\r\n    .probation-eval-print h1.title { text-align: center; font-size: 16pt; font-weight: bold; letter-spacing: 1px; margin: 10px 0 14px 0; }\r\n\r\n    .probation-eval-print .details-box { border: 2px solid #000; margin-bottom: 16px; }\r\n    .probation-eval-print .details-header { background: #fff; border-bottom: 2px solid #000; font-weight: bold; padding: 4px 8px; font-size: 11pt; }\r\n    .probation-eval-print .details-row { display: flex; border-bottom: 1px solid #000; }\r\n    .probation-eval-print .details-row:last-child { border-bottom: none; }\r\n    .probation-eval-print .details-label { width: 180px; font-weight: bold; padding: 6px 8px; white-space: nowrap; }\r\n    .probation-eval-print .details-value { flex: 1; padding: 6px 8px; border-left: 1px solid #000; }\r\n\r\n    .probation-eval-print table.eval-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }\r\n    .probation-eval-print table.eval-table th, .probation-eval-print table.eval-table td {\r\n      border: 1px solid #000; padding: 5px 8px; font-size: 10.5pt; vertical-align: top;\r\n    }\r\n    .probation-eval-print table.eval-table th { font-weight: bold; text-align: left; }\r\n    .probation-eval-print table.eval-table td.cat-col { width: 28%; font-weight: 600; }\r\n    .probation-eval-print table.eval-table td.detail-col { width: 72%; }\r\n\r\n    .probation-eval-print .footer-note { margin-top: 24px; }\r\n    .probation-eval-print .recommendation { margin-bottom: 14px; }\r\n    .probation-eval-print .signature-line { margin-top: 10px; border-bottom: 1px solid #000; width: 60%; height: 22px; }\r\n  </style>\r\n\r\n{{ letter_head }}\r\n  <div class=\"divider\"></div>\r\n\r\n  <h1 class=\"title\">PROBATION EVALUATION FORM</h1>\r\n\r\n  <!-- Employee Details -->\r\n  <div class=\"details-box\">\r\n    <div class=\"details-header\">EMPLOYEE DETAILS</div>\r\n    <div class=\"details-row\">\r\n      <div class=\"details-label\">EMPLOYEE NAME:</div>\r\n      <div class=\"details-value\">{{ doc.employee_name or \"\" }}</div>\r\n    </div>\r\n    <div class=\"details-row\">\r\n      <div class=\"details-label\">EMPLOYEE CODE:</div>\r\n      <div class=\"details-value\">{{ doc.employee or \"\" }}</div>\r\n    </div>\r\n    <div class=\"details-row\">\r\n      <div class=\"details-label\">JOB TITLE:</div>\r\n      <div class=\"details-value\">{{ doc.job_title or \"\" }}</div>\r\n    </div>\r\n    <div class=\"details-row\">\r\n      <div class=\"details-label\">DEPARTMENT:</div>\r\n      <div class=\"details-value\">{{ doc.department or \"\" }}</div>\r\n    </div>\r\n    <div class=\"details-row\">\r\n      <div class=\"details-label\">JOINING DATE:</div>\r\n      <div class=\"details-value\">{{ frappe.utils.formatdate(doc.joining_date) if doc.joining_date else \"\" }}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Category Evaluation Table -->\r\n  <table class=\"eval-table\">\r\n    <thead>\r\n      <tr>\r\n        <th class=\"cat-col\">Category Evaluation</th>\r\n        <th class=\"detail-col\">Details</th>\r\n        <th class=\"detail-col\">Score</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      {% for row in doc.probation_evaluation_form_item %}\r\n      <tr>\r\n        <td class=\"cat-col\">{{ loop.index }}. {{ row.category or \"\" }}</td>\r\n        <td class=\"detail-col\">{{ row.details or \"\" }}</td>\r\n        <td class=\"detail-col\">{{ row.score or \"\" }}</td>\r\n      </tr>\r\n      {% endfor %}\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- Footer -->\r\n  <div class=\"footer-note\">\r\n    <div class=\"recommendation\">\r\n      <strong>Final recommendation on whether to confirm employment, extend probation, or terminate:</strong>\r\n      <div class=\"signature-line\"></div>\r\n    </div>\r\n    <p><strong>Note:</strong> Completed form should be returned to the Human Resource Manager.</p>\r\n  </div>\r\n</div>",
