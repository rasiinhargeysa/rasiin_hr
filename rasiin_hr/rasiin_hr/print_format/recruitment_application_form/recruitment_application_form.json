 "doc_type": "Recruitment Application Form",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"recruitment-app-print\">\r\n  <style>\r\n    .recruitment-app-print { font-family: Arial, sans-serif; color: #000; font-size: 8.5pt; line-height: 1.15; }\r\n\r\n    .recruitment-app-print h1.title { text-align:center; font-size:13pt; font-weight:bold; margin: 4px 0 8px 0; }\r\n\r\n    .recruitment-app-print .two-col { display: flex; gap: 8px; margin-bottom: 6px; }\r\n    .recruitment-app-print .two-col > div { width: 50%; }\r\n\r\n    .recruitment-app-print table.field-table { width: 100%; border-collapse: collapse; table-layout: fixed; }\r\n    .recruitment-app-print table.field-table col.col-field { width: 35%; }\r\n    .recruitment-app-print table.field-table col.col-info { width: 65%; }\r\n    .recruitment-app-print table.field-table td, .recruitment-app-print table.field-table th {\r\n      border: 1px solid #000; padding: 2px 6px; font-size: 8pt; vertical-align: middle; line-height: 1.15;\r\n    }\r\n    .recruitment-app-print tr.section-title td {\r\n      border: 1px solid #000; border-bottom: none; text-align: center; font-weight: bold; color: #c0392b; padding: 2px 6px;\r\n    }\r\n    .recruitment-app-print tr.col-header td { font-weight: bold; }\r\n    .recruitment-app-print td.field-label { font-weight: bold; }\r\n    .recruitment-app-print .checkbox-row { display: flex; gap: 14px; flex-wrap: wrap; }\r\n    .recruitment-app-print .checkbox-row span { white-space: nowrap; }\r\n\r\n    .recruitment-app-print table.grid-table { width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 6px; }\r\n    .recruitment-app-print table.grid-table td, .recruitment-app-print table.grid-table th {\r\n      border: 1px solid #000; padding: 2px 6px; font-size: 8pt; vertical-align: top;\r\n    }\r\n    .recruitment-app-print table.grid-table th { font-weight: bold; text-align: left; }\r\n    .recruitment-app-print table.grid-table td.blank-row { height: 14px; }\r\n\r\n    .recruitment-app-print .section-box { border: 1px solid #000; border-top: none; margin-bottom: 6px; }\r\n    .recruitment-app-print .section-box-header { border-bottom: 1px solid #000; text-align:left; font-weight:bold; color:#c0392b; padding: 2px 6px; border-top: 1px solid #000; }\r\n    .recruitment-app-print table.skills-table { width: 100%; border-collapse: collapse; }\r\n    .recruitment-app-print table.skills-table td { border: 1px solid #000; padding: 2px 6px; font-size: 8pt; }\r\n    .recruitment-app-print table.skills-table td.field-label { font-weight: bold; width: 20%; }\r\n\r\n    .recruitment-app-print .declaration-box { border: 1px solid #000; padding: 6px 8px; }\r\n    .recruitment-app-print .declaration-box .sect-title { font-weight: bold; color: #c0392b; margin-bottom: 4px; }\r\n    .recruitment-app-print .sig-row { display: flex; gap: 40px; margin-top: 14px; }\r\n    .recruitment-app-print .sig-row .val { border-bottom: 1px solid #000; display: inline-block; min-width: 200px; margin-left: 4px; }\r\n  </style>\r\n\r\n  {{ letter_head }}\r\n\r\n  <h1 class=\"title\">Recruitment Application Form</h1>\r\n\r\n  <!-- Section 1 & 2 side by side -->\r\n  <div class=\"two-col\">\r\n    <div>\r\n      <table class=\"field-table\">\r\n        <colgroup><col class=\"col-field\"><col class=\"col-info\"></colgroup>\r\n        <tr class=\"section-title\"><td colspan=\"2\">Section 1: Personal Information</td></tr>\r\n        <tr class=\"col-header\"><td>Field</td><td>Information</td></tr>\r\n        <tr><td class=\"field-label\">Full Name</td><td>{{ doc.full_name or \"\" }}</td></tr>\r\n        <tr><td class=\"field-label\">Date of Birth</td><td>{{ frappe.utils.formatdate(doc.date_of_birth) if doc.date_of_birth else \"\" }}</td></tr>\r\n        <tr>\r\n          <td class=\"field-label\">Gender</td>\r\n          <td>\r\n            <div class=\"checkbox-row\">\r\n              <span>{{ \"\u2714\" if doc.gender == \"Male\" else \"\u2610\" }} Male</span>\r\n              <span>{{ \"\u2714\" if doc.gender == \"Female\" else \"\u2610\" }} Female</span>\r\n            </div>\r\n          </td>\r\n        </tr>\r\n        <tr><td class=\"field-label\">Contact Number</td><td>{{ doc.contact_number or \"\" }}</td></tr>\r\n        <tr><td class=\"field-label\">Email Address</td><td>{{ doc.email_address or \"\" }}</td></tr>\r\n        <tr><td class=\"field-label\">Home Address</td><td>{{ doc.home_address or \"\" }}</td></tr>\r\n      </table>\r\n    </div>\r\n    <div>\r\n      <table class=\"field-table\">\r\n        <colgroup><col class=\"col-field\"><col class=\"col-info\"></colgroup>\r\n        <tr class=\"section-title\"><td colspan=\"2\">Section 2: Position Applied For</td></tr>\r\n        <tr class=\"col-header\"><td>Field</td><td>Information</td></tr>\r\n        <tr><td class=\"field-label\">Job Title</td><td>{{ doc.job_title or \"\" }}</td></tr>\r\n        <tr><td class=\"field-label\">Department</td><td>{{ doc.department or \"\" }}</td></tr>\r\n        <tr>\r\n          <td class=\"field-label\">Employment Type</td>\r\n          <td>\r\n            <div class=\"checkbox-row\">\r\n              <span>{{ \"\u2714\" if doc.employment_type == \"Permanent\" else \"\u2610\" }} Permanent</span>\r\n              <span>{{ \"\u2714\" if doc.employment_type == \"Fixed-term\" else \"\u2610\" }} Fixed-term</span>\r\n            </div>\r\n            <div class=\"checkbox-row\"><span>{{ \"\u2714\" if doc.employment_type == \"Internship\" else \"\u2610\" }} Internship</span></div>\r\n          </td>\r\n        </tr>\r\n        <tr>\r\n          <td class=\"field-label\">Job Category</td>\r\n          <td>\r\n            <div class=\"checkbox-row\">\r\n              <span>{{ \"\u2714\" if doc.job_category == \"Full-time\" else \"\u2610\" }} Full-time</span>\r\n              <span>{{ \"\u2714\" if doc.job_category == \"Part-time\" else \"\u2610\" }} Part-time</span>\r\n            </div>\r\n          </td>\r\n        </tr>\r\n        <tr><td class=\"field-label\">Expected Salary</td><td>{{ frappe.utils.fmt_money(doc.expected_salary) if doc.expected_salary else \"\" }}</td></tr>\r\n        <tr><td class=\"field-label\">Available Start Date</td><td>{{ frappe.utils.formatdate(doc.available_start_date) if doc.available_start_date else \"\" }}</td></tr>\r\n      </table>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Section 3: Education Background -->\r\n  <div class=\"section-box\">\r\n    <div class=\"section-box-header\">Section 3: Education Background</div>\r\n    <table class=\"grid-table\">\r\n      <colgroup><col style=\"width:18%\"><col style=\"width:17%\"><col style=\"width:13%\"><col style=\"width:12%\"><col style=\"width:14%\"><col style=\"width:26%\"></colgroup>\r\n      <tr><th>School/University</th><th>Qualification</th><th>Level</th><th>Year of Passing</th><th>Class/Percentage</th><th>Major/Optional Subjects</th></tr>\r\n      {% for row in doc.employee_education %}\r\n      <tr>\r\n        <td>{{ row.school_univ or \"\" }}</td>\r\n        <td>{{ row.qualification or \"\" }}</td>\r\n        <td>{{ row.level or \"\" }}</td>\r\n        <td>{{ row.year_of_passing or \"\" }}</td>\r\n        <td>{{ row.class_per or \"\" }}</td>\r\n        <td>{{ row.maj_opt_subj or \"\" }}</td>\r\n      </tr>\r\n      {% endfor %}\r\n    </table>\r\n  </div>\r\n\r\n  <!-- Section 4: Work Experience -->\r\n  <div class=\"section-box\">\r\n    <div class=\"section-box-header\">Section 4: Work Experience</div>\r\n    <table class=\"grid-table\">\r\n      <colgroup><col style=\"width:18%\"><col style=\"width:16%\"><col style=\"width:14%\"><col style=\"width:24%\"><col style=\"width:14%\"><col style=\"width:14%\"></colgroup>\r\n      <tr><th>Company</th><th>Designation</th><th>Salary</th><th>Address</th><th>Contact</th><th>Total Experience</th></tr>\r\n      {% for row in doc.employee_external_work_history %}\r\n      <tr>\r\n        <td>{{ row.company_name or \"\" }}</td>\r\n        <td>{{ row.designation or \"\" }}</td>\r\n        <td>{{ frappe.utils.fmt_money(row.salary) if row.salary else \"\" }}</td>\r\n        <td>{{ row.address or \"\" }}</td>\r\n        <td>{{ row.contact or \"\" }}</td>\r\n        <td>{{ row.total_experience or \"\" }}</td>\r\n      </tr>\r\n      {% endfor %}\r\n    </table>\r\n  </div>\r\n\r\n  <!-- Section 5: Skills & Competencies -->\r\n  <div class=\"section-box\">\r\n    <div class=\"section-box-header\">Section 5: Skills & Competencies</div>\r\n    <table class=\"skills-table\">\r\n      <tr><td class=\"field-label\">Technical Skills</td><td>{{ doc.technical_skills or \"\" }}</td></tr>\r\n      <tr><td class=\"field-label\">Soft Skills</td><td>{{ doc.soft_skills or \"\" }}</td></tr>\r\n      <tr><td class=\"field-label\">Languages</td><td>{{ doc.languages or \"\" }}</td></tr>\r\n    </table>\r\n  </div>\r\n\r\n  <!-- Section 6: References -->\r\n  <div class=\"section-box\">\r\n    <div class=\"section-box-header\">Section 6: References</div>\r\n    <table class=\"grid-table\">\r\n      <colgroup><col style=\"width:34%\"><col style=\"width:22%\"><col style=\"width:22%\"><col style=\"width:22%\"></colgroup>\r\n      <tr><th>Name</th><th>Position</th><th>Contact Number</th><th>Email</th></tr>\r\n      {% for row in doc.references %}\r\n      <tr>\r\n        <td>{{ row.name1 or \"\" }}</td>\r\n        <td>{{ row.position or \"\" }}</td>\r\n        <td>{{ row.contact_number or \"\" }}</td>\r\n        <td>{{ row.email or \"\" }}</td>\r\n      </tr>\r\n      {% endfor %}\r\n    </table>\r\n  </div>\r\n\r\n  <!-- Section 7: Declaration -->\r\n  <div class=\"declaration-box\">\r\n    <div class=\"sect-title\">Section 7: Declaration</div>\r\n    <div>I hereby declare that the information provided above is true and complete to the best of my knowledge.</div>\r\n    <div class=\"sig-row\">\r\n      <div><strong>Applicant Signature:</strong><span class=\"val\"></span></div>\r\n      <div><strong>Date:</strong><span class=\"val\"></span></div>\r\n    </div>\r\n  </div>\r\n</div>",
