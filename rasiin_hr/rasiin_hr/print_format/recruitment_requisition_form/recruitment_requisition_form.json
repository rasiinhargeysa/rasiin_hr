 "html": "<div class=\"recruitment-req-print\">\r\n  <style>\r\n    .recruitment-req-print { font-family: Arial, sans-serif; color: #000; font-size: 8.5pt; line-height: 1.15; }\r\n\r\n    .recruitment-req-print h1.title { text-align:center; font-size:13pt; font-weight:bold; margin: 4px 0 8px 0; }\r\n\r\n    .recruitment-req-print table.field-table { width: 100%; border-collapse: collapse; margin-bottom: 6px; table-layout: fixed; }\r\n    .recruitment-req-print table.field-table col.col-field { width: 35%; }\r\n    .recruitment-req-print table.field-table col.col-info { width: 65%; }\r\n    .recruitment-req-print table.field-table td, .recruitment-req-print table.field-table th {\r\n      border: 1px solid #000; padding: 2px 6px; font-size: 8pt; vertical-align: middle; line-height: 1.15;\r\n    }\r\n    .recruitment-req-print table.field-table tr.section-title td {\r\n      border-left: 1px solid #000; border-right: 1px solid #000; border-top: 1px solid #000; border-bottom: none;\r\n      text-align: center; font-weight: bold; color: #c0392b; padding: 2px 6px;\r\n    }\r\n    .recruitment-req-print table.field-table tr.col-header td {\r\n      background: #f8e0ad; font-weight: bold;\r\n    }\r\n    .recruitment-req-print table.field-table td.field-label { font-weight: bold; }\r\n    .recruitment-req-print .checkbox-row { display: flex; gap: 18px; flex-wrap: wrap; }\r\n    .recruitment-req-print .checkbox-row span { white-space: nowrap; }\r\n\r\n    .recruitment-req-print table.approvals-table { width: 100%; border-collapse: collapse; margin-bottom: 4px; table-layout: fixed; }\r\n    .recruitment-req-print table.approvals-table td, .recruitment-req-print table.approvals-table th {\r\n      border: 1px solid #000; padding: 2px 6px; font-size: 8pt;\r\n    }\r\n    .recruitment-req-print table.approvals-table th { background: #f8e0ad; font-weight: bold; text-align: left; }\r\n    .recruitment-req-print table.approvals-table col.col-role { width: 28%; }\r\n    .recruitment-req-print table.approvals-table col.col-name { width: 24%; }\r\n    .recruitment-req-print table.approvals-table col.col-sign { width: 24%; }\r\n    .recruitment-req-print table.approvals-table col.col-date { width: 24%; }\r\n    .recruitment-req-print table.approvals-table td.role-cell { font-weight: bold; }\r\n    .recruitment-req-print table.approvals-table td.blank-cell { height: 14px; }\r\n  </style>\r\n\r\n  {{ letter_head }}\r\n\r\n  <h1 class=\"title\">Recruitment Requisition Form</h1>\r\n\r\n  <!-- Section 1: Position Details -->\r\n  <table class=\"field-table\">\r\n    <colgroup><col class=\"col-field\"><col class=\"col-info\"></colgroup>\r\n    <tr class=\"section-title\"><td colspan=\"2\">Section 1: Position Details</td></tr>\r\n    <tr class=\"col-header\"><td>Field</td><td>Information</td></tr>\r\n    <tr><td class=\"field-label\">Job Title</td><td class=\"info-cell\">{{ doc.job_title or \"\" }}</td></tr>\r\n    <tr><td class=\"field-label\">Department</td><td class=\"info-cell\">{{ doc.department or \"\" }}</td></tr>\r\n    <tr><td class=\"field-label\">Reporting Manager / Position</td><td class=\"info-cell\">{{ doc.reporting_manager_position or \"\" }}</td></tr>\r\n    <tr>\r\n      <td class=\"field-label\">Employment Type</td>\r\n      <td class=\"info-cell\">\r\n        <div class=\"checkbox-row\">\r\n          <span>{{ \"\u2714\" if doc.employment_type == \"Open-ended\" else \"\u2610\" }} Open-ended</span>\r\n          <span>{{ \"\u2714\" if doc.employment_type == \"Fixed-term\" else \"\u2610\" }} Fixed-term</span>\r\n          <span>{{ \"\u2714\" if doc.employment_type == \"Internship\" else \"\u2610\" }} Internship</span>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"field-label\">Job Category</td>\r\n      <td class=\"info-cell\">\r\n        <div class=\"checkbox-row\">\r\n          <span>{{ \"\u2714\" if doc.job_category == \"Full-time\" else \"\u2610\" }} Full-time</span>\r\n          <span>{{ \"\u2714\" if doc.job_category == \"Part-time\" else \"\u2610\" }} Part-time</span>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n    <tr><td class=\"field-label\">Number of Positions</td><td class=\"info-cell\">{{ doc.number_of_positions or \"\" }}</td></tr>\r\n  </table>\r\n\r\n  <!-- Section 2: Justification -->\r\n  <table class=\"field-table\">\r\n    <colgroup><col class=\"col-field\"><col class=\"col-info\"></colgroup>\r\n    <tr class=\"section-title\"><td colspan=\"2\">Section 2: Justification</td></tr>\r\n    <tr class=\"col-header\"><td>Field</td><td>Information</td></tr>\r\n    <tr>\r\n      <td class=\"field-label\">Reason for Recruitment</td>\r\n      <td class=\"info-cell\">\r\n        <div class=\"checkbox-row\">\r\n          <span>{{ \"\u2714\" if doc.reason_for_recruitment == \"New Position\" else \"\u2610\" }} New Position</span>\r\n          <span>{{ \"\u2714\" if doc.reason_for_recruitment == \"Replacement\" else \"\u2610\" }} Replacement</span>\r\n          <span>{{ \"\u2714\" if doc.reason_for_recruitment == \"Expansion\" else \"\u2610\" }} Expansion</span>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n    <tr><td class=\"field-label\">Business Justification</td><td class=\"info-cell\">{{ doc.business_justification or \"\" }}</td></tr>\r\n    <tr><td class=\"field-label\">Expected Start Date</td><td class=\"info-cell\">{{ frappe.utils.formatdate(doc.expected_start_date) if doc.expected_start_date else \"\" }}</td></tr>\r\n  </table>\r\n\r\n  <!-- Section 3: Job Requirements -->\r\n  <table class=\"field-table\">\r\n    <colgroup><col class=\"col-field\"><col class=\"col-info\"></colgroup>\r\n    <tr class=\"section-title\"><td colspan=\"2\">Section 3: Job Requirements</td></tr>\r\n    <tr class=\"col-header\"><td>Field</td><td>Information</td></tr>\r\n    <tr><td class=\"field-label\">Minimum Qualifications</td><td class=\"info-cell\">{{ doc.minimum_qualifications or \"\" }}</td></tr>\r\n    <tr><td class=\"field-label\">Preferred Qualifications</td><td class=\"info-cell\">{{ doc.preferred_qualifications or \"\" }}</td></tr>\r\n    <tr><td class=\"field-label\">Key Skills</td><td class=\"info-cell\">{{ doc.key_skills or \"\" }}</td></tr>\r\n  </table>\r\n\r\n  <!-- Section 4: Compensation & Budget -->\r\n  <table class=\"field-table\">\r\n    <colgroup><col class=\"col-field\"><col class=\"col-info\"></colgroup>\r\n    <tr class=\"section-title\"><td colspan=\"2\">Section 4: Compensation & Budget</td></tr>\r\n    <tr class=\"col-header\"><td>Field</td><td>Information</td></tr>\r\n    <tr><td class=\"field-label\">Proposed Salary Range</td><td class=\"info-cell\">{{ doc.proposed_salary_range or \"\" }}</td></tr>\r\n    <tr>\r\n      <td class=\"field-label\">Budget Approval</td>\r\n      <td class=\"info-cell\">\r\n        <div class=\"checkbox-row\">\r\n          <span>{{ \"\u2714\" if doc.budget_approval == \"Yes\" else \"\u2610\" }} Yes</span>\r\n          <span>{{ \"\u2714\" if doc.budget_approval == \"No\" else \"\u2610\" }} No</span>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n    <tr><td class=\"field-label\">Approved By</td><td class=\"info-cell\">{{ doc.approved_by or \"\" }}</td></tr>\r\n  </table>\r\n\r\n  <!-- Section 5: Approvals -->\r\n  <table class=\"approvals-table\">\r\n    <colgroup><col class=\"col-role\"><col class=\"col-name\"><col class=\"col-sign\"><col class=\"col-date\"></colgroup>\r\n    <tr><th colspan=\"4\" style=\"text-align:center; color:#c0392b;\">Section 5: Approvals</th></tr>\r\n    <tr><th>Role</th><th>Name</th><th>Signature</th><th>Date</th></tr>\r\n    <tr><td class=\"role-cell\">Hospital Director Approval</td><td class=\"blank-cell\"></td><td class=\"blank-cell\"></td><td class=\"blank-cell\"></td></tr>\r\n    <tr><td class=\"role-cell\">Hiring Manager</td><td class=\"blank-cell\"></td><td class=\"blank-cell\"></td><td class=\"blank-cell\"></td></tr>\r\n    <tr><td class=\"role-cell\">HR Approval</td><td class=\"blank-cell\"></td><td class=\"blank-cell\"></td><td class=\"blank-cell\"></td></tr>\r\n    <tr><td class=\"role-cell\">Finance Approval</td><td class=\"blank-cell\"></td><td class=\"blank-cell\"></td><td class=\"blank-cell\"></td></tr>\r\n  </table>\r\n</div>",
