 "font_size": 14,
 "html": "<div class=\"staff-training-print\">\r\n  <style>\r\n    .staff-training-print { font-family: Arial, sans-serif; color: #000; font-size: 10pt; }\r\n\r\n    .staff-training-print .section-box { border: 2px solid #000; margin-bottom: 12px; }\r\n    .staff-training-print .section-header { border-bottom: 2px solid #000; font-weight: bold; padding: 3px 6px; font-size: 10.5pt; }\r\n\r\n    .staff-training-print .details-grid { display: flex; flex-wrap: wrap; }\r\n    .staff-training-print .details-cell { width: 50%; box-sizing: border-box; padding: 4px 6px; }\r\n    .staff-training-print .details-cell .lbl { font-weight: bold; }\r\n    .staff-training-print .details-cell .val { border-bottom: 1px solid #000; display: inline-block; min-width: 65%; padding-bottom: 1px; margin-left: 4px; }\r\n\r\n    .staff-training-print .content-box { min-height: 70px; padding: 6px; white-space: pre-wrap; }\r\n\r\n    .staff-training-print table.attendance-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; table-layout: fixed; }\r\n    .staff-training-print table.attendance-table th, .staff-training-print table.attendance-table td {\r\n      border: 1px solid #000; padding: 3px 6px; font-size: 9.5pt; vertical-align: middle;\r\n    }\r\n    .staff-training-print table.attendance-table th { font-weight: bold; text-align: left; }\r\n    .staff-training-print table.attendance-table col.col-no { width: 5%; }\r\n    .staff-training-print table.attendance-table col.col-empid { width: 12%; }\r\n    .staff-training-print table.attendance-table col.col-name { width: 28%; }\r\n    .staff-training-print table.attendance-table col.col-job { width: 30%; }\r\n    .staff-training-print table.attendance-table col.col-sign { width: 25%; }\r\n    .staff-training-print table.attendance-table td.center { text-align: center; }\r\n\r\n    .staff-training-print .confirm-box { border: 2px solid #000; padding: 6px 8px; display: flex; justify-content: space-between; margin-top: 10px; }\r\n    .staff-training-print .confirm-box .lbl { font-weight: bold; }\r\n    .staff-training-print .confirm-box .val { border-bottom: 1px solid #000; display: inline-block; min-width: 220px; margin-left: 4px; }\r\n  </style>\r\n\r\n  {{ letter_head }}\r\n\r\n  <h1 style=\"text-align:center; font-size:15pt; font-weight:bold; letter-spacing:1px; margin:8px 0 14px 0;\">\r\n    STAFF TRAINING FORM\r\n  </h1>\r\n\r\n  <!-- 1. Training Details -->\r\n  <div class=\"section-box\">\r\n    <div class=\"section-header\">1. Training Details</div>\r\n    <div class=\"details-grid\">\r\n      <div class=\"details-cell\"><span class=\"lbl\">Training Title:</span><span class=\"val\">{{ doc.training_title or \"\" }}</span></div>\r\n      <div class=\"details-cell\"><span class=\"lbl\">Date(s):</span><span class=\"val\">{{ doc.date or \"\" }}</span></div>\r\n      <div class=\"details-cell\"><span class=\"lbl\">Dept/Unit:</span><span class=\"val\">{{ doc.department or \"\" }}</span></div>\r\n      <div class=\"details-cell\"><span class=\"lbl\">Venue:</span><span class=\"val\">{{ doc.venue or \"\" }}</span></div>\r\n      <div class=\"details-cell\"><span class=\"lbl\">Trainer/Facilitator:</span><span class=\"val\">{{ doc.trainer_facilitator or \"\" }}</span></div>\r\n      <div class=\"details-cell\"><span class=\"lbl\">Co-Trainer:</span><span class=\"val\">{{ doc.co_trainer or \"\" }}</span></div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- 2. Brief Training Content -->\r\n  <div class=\"section-box\">\r\n    <div class=\"section-header\">2. Brief Training Content</div>\r\n    <div class=\"content-box\">{{ doc.brief_training_content or \"\" }}</div>\r\n  </div>\r\n\r\n  <!-- 3. Staff Attendance -->\r\n  <div class=\"section-box\" style=\"border-bottom: none;\">\r\n    <div class=\"section-header\">3. Staff Attendance</div>\r\n  </div>\r\n  <table class=\"attendance-table\">\r\n    <colgroup>\r\n      <col class=\"col-no\">\r\n      <col class=\"col-empid\">\r\n      <col class=\"col-name\">\r\n      <col class=\"col-job\">\r\n      <col class=\"col-sign\">\r\n    </colgroup>\r\n    <thead>\r\n      <tr>\r\n        <th>No.</th>\r\n        <th>Emp ID</th>\r\n        <th>Staff Name</th>\r\n        <th>Job Title</th>\r\n        <th>Signature</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      {% for row in doc.staff_training_form_item %}\r\n      <tr>\r\n        <td class=\"center\">{{ loop.index }}</td>\r\n        <td>{{ row.employee or \"\" }}</td>\r\n        <td>{{ row.employee_name or \"\" }}</td>\r\n        <td>{{ row.job_title or \"\" }}</td>\r\n        <td></td>\r\n      </tr>\r\n      {% endfor %}\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- Confirmed by -->\r\n  <div class=\"confirm-box\">\r\n    <div><span class=\"lbl\">Confirmed by:</span><span class=\"val\"></span></div>\r\n    <div><span class=\"lbl\">Date:</span><span class=\"val\"></span></div>\r\n  </div>\r\n</div>",
