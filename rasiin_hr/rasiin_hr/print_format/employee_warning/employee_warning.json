 "font_size": 14,
 "html": "<div class=\"warning-letter\">\r\n<style>\r\n  .warning-letter, .warning-letter * {\r\n    font-family: Calibri, 'Segoe UI', Arial, Helvetica, sans-serif !important;\r\n    color: #1a1a1a !important;\r\n    text-decoration: none;\r\n    box-sizing: border-box;\r\n  }\r\n  .warning-letter { font-size: 13px; line-height: 1.6; }\r\n\r\n  :root {\r\n    --navy: #10194F;\r\n    --orange: #E36C12;\r\n  }\r\n\r\n  .warning-letter .eyebrow {\r\n    font-size: 11px !important;\r\n    font-weight: 700 !important;\r\n    color: var(--navy) !important;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1px;\r\n    margin: 18px 0 4px 0;\r\n  }\r\n\r\n  .warning-letter .title {\r\n    text-align: center;\r\n    font-size: 22px !important;\r\n    font-weight: 800 !important;\r\n    color: var(--navy) !important;\r\n    text-transform: uppercase;\r\n    letter-spacing: 6px;\r\n    margin: 8px 0 6px 0;\r\n  }\r\n  .warning-letter .title-bar {\r\n    width: 90px;\r\n    height: 3px;\r\n    background: var(--orange);\r\n    margin: 0 auto 20px auto;\r\n  }\r\n\r\n  .warning-letter .ref-line {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    font-size: 12.5px !important;\r\n    font-weight: 700 !important;\r\n    margin-bottom: 14px;\r\n  }\r\n  .warning-letter .ref-line .ref-value { color: var(--navy) !important; }\r\n\r\n  .warning-letter .info-box {\r\n    border: 1.5px solid var(--navy);\r\n    background: #F7F8FB;\r\n    border-radius: 4px;\r\n    padding: 14px 18px;\r\n    margin-bottom: 20px;\r\n  }\r\n  .warning-letter .info-table { width: 100%; border-collapse: collapse; }\r\n  .warning-letter .info-table td { border: none; padding: 0 10px 0 0; vertical-align: top; font-size: 12.5px; }\r\n  .warning-letter .info-label {\r\n    display: block;\r\n    font-weight: 700 !important;\r\n    color: var(--navy) !important;\r\n    text-transform: uppercase;\r\n    font-size: 10.5px !important;\r\n    letter-spacing: 0.4px;\r\n    margin-bottom: 2px;\r\n  }\r\n  .warning-letter .info-value { font-size: 13px !important; }\r\n\r\n  .warning-letter .subject-bar {\r\n    background: var(--navy);\r\n    color: #fff !important;\r\n    padding: 8px 14px;\r\n    font-size: 12.5px !important;\r\n    font-weight: 700 !important;\r\n    letter-spacing: 0.3px;\r\n    margin-bottom: 18px;\r\n    border-radius: 3px;\r\n  }\r\n  .warning-letter .subject-bar * { color: #fff !important; }\r\n  .warning-letter .subject-bar .subject-value { font-weight: 400 !important; }\r\n  .warning-letter .subject-bar .subject-value.underline { text-decoration: underline !important; }\r\n\r\n  .warning-letter .body p { margin: 0 0 13px 0; text-align: left; }\r\n  .warning-letter .body b { font-weight: 700 !important; }\r\n\r\n  .warning-letter .sign-block { margin-top: 40px; }\r\n  .warning-letter .sign-block > p { margin: 0 0 14px 0; font-weight: 700 !important; }\r\n  .warning-letter .sign-box {\r\n    border: 1.5px solid var(--navy);\r\n    border-radius: 4px;\r\n    overflow: hidden;\r\n    margin-top: 10px;\r\n  }\r\n  .warning-letter .sign-box table { width: 100%; border-collapse: collapse; }\r\n  .warning-letter .sign-box td {\r\n    padding: 14px 18px;\r\n    font-size: 12.5px !important;\r\n    width: 50%;\r\n  }\r\n  .warning-letter .sign-box tr:first-child td { border-bottom: 1px solid var(--navy); }\r\n  .warning-letter .sign-box td:first-child { border-right: 1px solid var(--navy); }\r\n  .warning-letter .sign-fill { display: inline-block; border-bottom: 1px solid #999; min-width: 140px; height: 14px; margin-left: 6px; }\r\n</style>\r\n\r\n{{ letter_head }}\r\n\r\n<div class=\"eyebrow\">Disciplinary Action Notice</div>\r\n<div class=\"title\">\r\n  {%- if doc.warning_type == \"Verbal Warning\" %}Verbal Warning\r\n  {%- elif doc.warning_type == \"Termination\" %}Termination Letter\r\n  {%- else %}{{ doc.warning_type }}\r\n  {%- endif %}\r\n</div>\r\n<div class=\"title-bar\"></div>\r\n\r\n<div class=\"ref-line\">\r\n  <span>Warning No. <span class=\"ref-value\">{{ doc.name }}</span></span>\r\n  <span>Dated: <span class=\"ref-value\">{{ frappe.utils.formatdate(doc.date) if doc.date else \"\" }}</span></span>\r\n</div>\r\n\r\n<div class=\"info-box\">\r\n  <table class=\"info-table\">\r\n    <tr>\r\n      <td>\r\n        <span class=\"info-label\">Employee Name</span>\r\n        <span class=\"info-value\">{{ frappe.db.get_value(\"Employee\", doc.employee, \"employee_name\") or \"\" }}</span>\r\n      </td>\r\n      <td>\r\n        <span class=\"info-label\">Job Title</span>\r\n        <span class=\"info-value\">{{ frappe.db.get_value(\"Employee\", doc.employee, \"designation\") or \"\" }}</span>\r\n      </td>\r\n      <td>\r\n        <span class=\"info-label\">Department</span>\r\n        <span class=\"info-value\">{{ frappe.db.get_value(\"Employee\", doc.employee, \"department\") or \"\" }}</span>\r\n      </td>\r\n    </tr>\r\n  </table>\r\n</div>\r\n\r\n<div class=\"subject-bar\">\r\n  SUBJECT:\r\n  {%- if doc.warning_type == \"Verbal Warning\" %} <span class=\"subject-value\">DOCUMENTATION OF VERBAL WARNING</span>\r\n  {%- elif doc.warning_type == \"First Written Warning\" %} <span class=\"subject-value\">WRITTEN WARNING \u2013 MISCONDUCT/PERFORMANCE ISSUE</span>\r\n  {%- elif doc.warning_type == \"Final Written Warning\" %} <span class=\"subject-value\">FINAL WRITTEN WARNING \u2013 SERIOUS MISCONDUCT</span>\r\n  {%- elif doc.warning_type == \"Termination\" %} <span class=\"subject-value underline\">TERMINATION OF EMPLOYMENT \u2013 MISCONDUCT</span>\r\n  {%- endif %}\r\n</div>\r\n\r\n<div class=\"body\">\r\n<p>Dear {{ frappe.db.get_value(\"Employee\", doc.employee, \"employee_name\") or \"[Employee Name]\" }},</p>\r\n\r\n{{ doc.description | safe }}\r\n</div>\r\n\r\n<div class=\"sign-block\">\r\n  <p>Sincerely,</p>\r\n  {% if doc.warning_type == \"Verbal Warning\" %}\r\n  <p style=\"font-weight:400 !important;\">Manager</p>\r\n  {% else %}\r\n  <div class=\"sign-box\">\r\n    <table>\r\n      <tr>\r\n        <td>Manager\u2019s signature: <span class=\"sign-fill\"></span></td>\r\n        <td>Date: <span class=\"sign-fill\">{{doc.date or \"\"}}</span></td>\r\n      </tr>\r\n      <tr>\r\n        <td>Employee\u2019s signature: <span class=\"sign-fill\"></span></td>\r\n        <td>Date: <span class=\"sign-fill\">{{doc.date or \"\"}}</span></td>\r\n      </tr>\r\n    </table>\r\n  </div>\r\n  {% endif %}\r\n</div>\r\n\r\n</div>",
